# Copy to .env (gitignored) and fill in real values.
#
# Default setup routes every team's Claude agent through one third-party API
# router (e.g. https://app-us.ppapi.ai/v1). The router URL becomes
# ANTHROPIC_BASE_URL inside each team's dev container; the key becomes
# ANTHROPIC_API_KEY. Claude Code picks both up at launch.

# Use the router's API root (no /v1 suffix). Claude Code appends
# /v1/messages itself; including /v1 here would produce /v1/v1/messages → 404.
API_ROUTER_BASE=https://app-us.ppapi.ai
API_ROUTER_KEY=

# Per-team LLM keys are NOT how you isolate spend — not any more, and not by
# accident. An agent routed through the api-router never holds a provider key at
# all (it gets a principal token; the router substitutes the real key on forward),
# because an agent holding a real key could bill against it WITHOUT being metered.
# For per-team spend limits, price the models and cap the teams in game.yaml:
#
#   api_router:
#     pricing:                                     # USD per 1M tokens
#       claude-sonnet-4-6: { input: 3.0, output: 15.0 }
#     budgets:
#       team1: 25.00                               # 402 once team1 reaches $25
#
# Both default to off (rates 0.0 = free, no caps). They are ONE feature: a cap on a
# model priced at 0 can never fire, and startup warns if you configure that.

# ── Self-hosted API Router (apirouter/) ───────────────────────────────────
# Verbatim reverse-passthrough metering+firewall gateway. To route clients
# (agents / the judge) through it:
#   1. point their base_url at the router, e.g. in game.yaml:
#        API_ROUTER_BASE=http://api-router:8080
#   2. the ROUTER container holds the real upstream key (apirouter/config.example.yaml):
# UPSTREAM_API_KEY=          # single REAL upstream key — only the router holds it
#                            # (injected on forward, kept out of containers)
# No format translation; the upstream must accept whatever format the client sends.
# See docs/api_router_plan_v1.md for soft vs hard egress enforcement.

# ── Several providers on separate keys (optional) ──────────────────────────
# One router can front several providers, chosen per request from the model name —
# e.g. Claude billed to the official Anthropic key, everything else to a reseller.
# Name each provider's key here as APIROUTER_KEY_<UPSTREAM_ID> and declare NOTHING
# about keys in game.yaml; the orchestrator injects them into the router container.
#
# APIROUTER_KEY_ANTHROPIC=
# APIROUTER_KEY_PPAPI=
#
# then in game.yaml:
#   api_router:
#     upstreams:
#       anthropic: { base_url: https://api.anthropic.com }   # <- APIROUTER_KEY_ANTHROPIC
#       ppapi:     { base_url: https://app-us.ppapi.ai }     # <- APIROUTER_KEY_PPAPI
#     routes:
#       default: ppapi
#       by_model: { "claude-*": anthropic }   # globs, first match wins
#
# EVERY upstream must have a key — a keyless one has nothing valid to forward with,
# so the run aborts at startup rather than dying later as a match of AGENT_FAILED.
# Mutually exclusive with the single `upstream_url:` shorthand.

# ── Isolated agent network (apirouter as sole egress) ─────────────────────
# To make apirouter the ONLY way the agent can reach the internet, use the
# `cyberarena/agent` image ([dockerfiles/agent/]) and the new `internal: true`
# field on networks (no NAT, no default gateway → L3 cannot reach the public
# internet, only apirouter can). Wired via the dev node's `env:` block:
#
#   networks:
#     team1_net:  { subnet: 10.10.1.0/24,  internal: true }   # ← no public route
#     egress_net: { subnet: 10.10.99.0/24 }
#   nodes:
#     - id: team1_dev
#       image: cyberarena/agent
#       networks: [team1_net]                # internal-only
#       env:
#         HTTPS_PROXY: "http://api-router:3129"
#         HTTP_PROXY:  "http://api-router:3129"
#         NO_PROXY:    "127.0.0.1,localhost,api-router,host.docker.internal"
#     - id: api-router
#       image: cyberarena/api-router
#       networks: [team1_net, egress_net]    # bridges internal <-> internet
#
# Full recipe (incl. apt-doesn't-honor-env workaround):
# see docs/DEPLOY_ISOLATED_AGENT.md.

# ── v3 isolated runs (config/game_ico_v3_*.yaml: codex / opencode) ─────────
# These configs route every agent's LLM through the api-router and MCP through
# the on-net mcp-gateway, so they need just TWO secrets here:
#
#   API_ROUTER_KEY             - the single REAL upstream key (the api-router
#                                injects it on forward; agents never hold it).
#                                Set it above.
#   CYBERARENA_FACILITY_TOKEN  - shared facility<->GameMgr auth token; any
#                                random string. Used by the flag-service +
#                                health-poller containers.
CYBERARENA_FACILITY_TOKEN=
#
# OPTIONAL — control-plane (admin) auth. Gates the destructive REST endpoints
# POST /game/start and POST /game/stop (X-Admin-Token header). Read only by the
# host GameMgr; no container needs it, so it is NOT referenced in any config
# yaml. Fail closed: leave BLANK and those endpoints are simply disabled (403) —
# a match then stops only host-side (SIGINT / loop completion). Set a random
# string to enable stopping/starting over HTTP.
CYBERARENA_ADMIN_TOKEN=
#
# NOTE: there are NO per-team LLM keys here. A routed team's `agent.api_key` is a
# NON-SECRET principal token (a per-team billing label like `cad-team1`) declared
# PLAINLY in game.yaml — not an env var, so parallel experiments don't collide on a
# shared name. The router holds the one real key (API_ROUTER_KEY, or APIROUTER_KEY_<ID>
# per upstream) and substitutes it on forward. Leave a team's api_key empty and the
# orchestrator fills a `cad-<team_id>` default.
